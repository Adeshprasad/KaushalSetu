rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Jobs collection (public catalog with open seed and demo admin management)
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Government Schemes collection (public catalog with initial seeding)
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Candidate Job Applications
    match /applications/{applicationId} {
      allow read: if true;
      allow write: if true;
    }

    // Ping / System diagnostics & Connection test
    match /system/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
