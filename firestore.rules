rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public catalogs: anyone can read, only signed-in users can write
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Applications: users see and create only their own
    match /applications/{applicationId} {
      allow read: if request.auth != null && resource.data.applicantId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is blocked (the old system/test collections are gone)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
